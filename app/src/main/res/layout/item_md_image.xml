<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/md_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_code_block"
        android:contentDescription="@string/image_missing"
        android:maxHeight="360dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/md_image_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_code_block"
        android:padding="16dp"
        android:text="@string/image_missing"
        android:textColor="@color/moread_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
